   </wvobject>
   <wvobject type="logic" fp_name="/processor_tb/DM_writeEnable">
      <obj_property name="ElementShortName">DM_writeEnable</obj_property>
      <obj_property name="ObjectShortName">DM_writeEnable</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/processor_tb/DM_writeData">
      <obj_property name="ElementShortName">DM_writeData[63:0]</obj_property>
      <obj_property name="ObjectShortName">DM_writeData[63:0]</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/processor_tb/DM_addr">
