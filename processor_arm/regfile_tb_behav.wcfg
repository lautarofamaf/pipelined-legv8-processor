      <obj_property name="ObjectShortName">DM_addr[63:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/processor_tb/dump">
      <obj_property name="ElementShortName">dump</obj_property>
      <obj_property name="ObjectShortName">dump</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/processor_tb/N">
