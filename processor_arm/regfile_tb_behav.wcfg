<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="processor_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="processor_tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="90.000 ns"></ZoomStartTime>
      <ZoomEndTime time="630.001 ns"></ZoomEndTime>
      <Cursor1Time time="540.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="167"></NameColumnWidth>
      <ValueColumnWidth column_width="122"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="11" />
   <wvobject fp_name="divider404" type="divider">
      <obj_property name="label">Clk</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="BkColor">#FFA500</obj_property>
   </wvobject>
   <wvobject fp_name="divider403" type="divider">
      <obj_property name="label">Branch</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="BkColor">#00FFFF</obj_property>
   </wvobject>
   <wvobject fp_name="divider210" type="divider">
      <obj_property name="label">PC</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/processor_tb/CLOCK_50">
      <obj_property name="ElementShortName">CLOCK_50</obj_property>
      <obj_property name="ObjectShortName">CLOCK_50</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/processor_tb/reset">
      <obj_property name="ElementShortName">reset</obj_property>
